  "rules": {
    "ink": "text color is the base's own ink; a light ink (luminance > 0.5) means a dark base",
    "light_base_pull": "light bases are mixed 6% toward white before any surface math",
    "paper_base": "a light base with luminance > 0.86 is \"paper\" (white)",
    "card": "dark: base.mix(white,0.12) \u00b7 paper: base.mix(ink,0.055) \u00b7 else: base.mix(white,0.60)",
    "card_border": "dark: base.mix(white,0.20) \u00b7 paper: base.mix(ink,0.11) \u00b7 else: base.mix(ink,0.16)",
    "sub": "base.mix(ink,0.76)",
    "faint": "base.mix(ink,0.58)",
    "on_accent": "accent luminance > 0.62 ? #141412 : #F5F5F0",
    "urgent": "dark base: #FF9A6A \u00b7 light base: #D96A3B",
    "luminance": "0.299r + 0.587g + 0.114b"
  }
